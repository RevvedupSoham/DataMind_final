# Server-side Groq credentials
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=

# Preferred current Supabase server key. NEVER expose this to the browser.
SUPABASE_SECRET_KEY=

# Legacy fallback for existing Supabase projects. Use only if SECRET_KEY is not set.
SUPABASE_SERVICE_ROLE_KEY=

# Used only to identify the local app URL in server-side configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Long random string used to sign session cookies (auth). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
